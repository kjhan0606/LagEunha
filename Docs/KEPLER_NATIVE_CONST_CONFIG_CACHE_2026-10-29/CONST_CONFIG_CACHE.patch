+/* Opt-in process-constant configuration. Default-off retains the legacy
+ * dynamic environment reads. Atomic publication permits concurrent host callers.
+ * When enabled, callers must keep these environment settings fixed for the run.
+ */
+static inline int gfs_native_const_config_on(void){
+    static int mode=-1;
+    int value=__atomic_load_n(&mode,__ATOMIC_RELAXED);
+    if(value<0){const char *s=getenv("GFS_NATIVE_CONST_CONFIG");value=s && atoi(s)>0;
+        __atomic_store_n(&mode,value,__ATOMIC_RELAXED);}
+    return value;
+}
