# SoundWave3D: flags on top of common/flags_base.env
source "$(dirname "${BASH_SOURCE[0]}")/../common/flags_base.env"
export GFS_FLOOR_LOG=0           # nothing can reach the floor at P0 = 0.6
LAG3D_TEND=1.0                   # one period for --dir x (1/sqrt(3) for diag)
LAG3D_DUMPDT=0.25
LAG3D_COURANT=0.3
LAG3D_AMP=1e-6
