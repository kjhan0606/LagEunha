source "$(dirname "${BASH_SOURCE[0]}")/../common/flags_base.env"
# RK4 is required: central/self-gravity forces (KDK breaks circular orbits in
# this code; the RK4 blend path is the one that carries the central force).
LAG3D_TEND=3.0
LAG3D_DUMPDT=0.1                 # need a snapshot at t = 0.8 for the profile check
LAG3D_COURANT=0.3
LAG3D_EPS=0.01                   # Plummer softening (open decision, README)
LAG3D_BACKGROUND=none            # or uniform (Voronoi outer boundary, README)
