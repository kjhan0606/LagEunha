### LagEunha 3D test parameters (Exam/Tests3D). Template; run.slurm fills the @-delimited placeholders.
### Lines marked [2D key] exist in Params/params.h and are parsed today.
### Lines marked [3D key] are read by the 3D GFS driver (Exam/exam3d_gfs.c).
### The 3D driver reads this file itself; [2D key] lines are checked (av_mode 5,
### entropy_mode 0, kappa <= 0 required; way != 1 / gpu / centroid shift warn).
### Optional 3D keys: "Hydro3D boundary" (periodic|reflect|outflow, one or three
### comma-separated; default from the IC periodic flags, non-periodic = reflect),
### "Hydro3D theta" (tree opening angle, 0.5), "Hydro3D max steps",
### "GAS AlphaVis"/"GAS BetaVis" (Monaghan AV on top of HLLC, default 0).
define Simulation Model     = @MODEL@            # [3D key] Hydro3D
define Gamma_hydro         = @GAMMA@            # [2D key]
define Hydro time-stepping way = 1              # [2D key] 1 = RK4 (GFS integrator; required with gravity)
define Courant_hydro       = @COURANT@          # [2D key]
define Nx                  = @NX@               # [2D key]
define Ny                  = @NY@               # [2D key]
define Nz                  = @NZ@               # [2D key]
define GAS av_mode        = 5                   # [2D key] MUSCL + HLLC
define GAS use_muscl      = 1                   # [2D key]
define GAS kappa           = 0                  # [2D key] 0 = Voronoi (w2 = 0)
define GAS entropy_mode   = 0                   # [2D key] evolve ie
define GAS gpu_enabled    = 0                   # [2D key] no 3D GPU kernel exists
define Voro centroid shift factor = 0           # [2D key] no mesh steering in the budget
define Hydro3D IC file     = @ICFILE@           # [3D key] LAG3DV1 file (common/lag3d_ic.h)
define Hydro3D t_end       = @TEND@             # [3D key]
define Hydro3D dump dt     = @DUMPDT@           # [3D key] snapshots in LAG3DV1, named snap_%06d.l3d
define Hydro3D gravity     = @GRAVITY@          # [3D key] 0 none, 1 self-gravity (isolated)
define Hydro3D softening   = @EPS@              # [3D key] Plummer, only if gravity = 1
#End of Ascii Header
