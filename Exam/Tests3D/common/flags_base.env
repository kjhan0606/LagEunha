# Environment flags shared by every 3D test (sourced by */config.env).
# These are the 2D conventions from code_review_grokbot.md; the 3D driver is
# expected to honour the same names.
export SEDOV_PHASE1=1            # die holds dE/dt; RK4 stage uses phase1_ie_stage
export GFS_FLOOR_LOG=1           # [RK4F]-style log of cells that hit ie <= 0
unset GFS_DUAL_ENERGY            # one energy mechanism per ledger (off)
unset GFS_ENTROPY_SWITCH         # off: the 1D kinetic form damaged blast/Noh
unset GFS_HALF_LIMIT             # follows the entropy switch (off)
unset GFS_ES_COEF
unset GFS_LAGUERRE_ROTATION      # irrelevant at kappa = 0 (Voronoi faces)
unset EUNHA_IC EUNHA_KEPLER_PROFILE EUNHA_KEPLER_DTETA
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}
# Pair pressure: capped law P <= 32 rho c^2 with gfs_pair_work_limit
# (nshare = 6 in 2D; a 3D Voronoi cell has ~15 faces, see README).
# Integrator: RK4 ("Hydro time-stepping way = 1" in params3d.dat).
